APP_NAME=Textback
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://textback.test
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Postgres via Herd). Local user typically has no password.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=textback
DB_USERNAME=ash
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: local uses the "log" driver (mail lands in storage/logs/laravel.log).
# For a local inbox UI, install mailpit (brew install mailpit), set
# MAIL_MAILER=smtp and MAIL_PORT=1025. In production set MAIL_MAILER=resend.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@textback.test"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (set MAIL_MAILER=resend in production). Key: https://resend.com/api-keys
RESEND_API_KEY=

# Google sign-in (Socialite). Create OAuth creds at console.cloud.google.com.
# The redirect URI must be authorized in the Google console. Google does not
# accept .test domains, so for local dev use the Cloudflare tunnel URL (or
# http://localhost). Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------
# Twilio (Voice bridging + Programmable SMS). Fill from console.twilio.com.
# Leave blank to run the app in "not configured" mode (onboarding + UI work,
# real calls/texts are disabled). Webhooks must be publicly reachable in
# production (use the Cloudflare tunnel below); the local simulator
# (php artisan textback:simulate-missed-call) needs no creds.
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: a Messaging Service SID (recommended for A2P 10DLC). If set, SMS
# is sent via the service; otherwise it falls back to the account's number.
TWILIO_MESSAGING_SERVICE_SID=
# Seconds to ring the operator's phone before treating the call as missed.
TWILIO_DIAL_TIMEOUT=18
# Validate inbound webhook signatures (disable only for local sim testing).
TWILIO_VALIDATE_SIGNATURE=true

# ------------------------------------------------------------------
# Stripe (Cashier) - trials, subscriptions, the money-back guarantee.
# Test-mode keys locally, live keys only in production. Create two recurring
# prices in Stripe and paste their price IDs below.
# ------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=

# ------------------------------------------------------------------
# Textback product settings (safe defaults; override if needed).
# ------------------------------------------------------------------
TEXTBACK_TRIAL_DAYS=14
TEXTBACK_TRIAL_LEAD_CAP=5
TEXTBACK_GUARANTEE_DAYS=30
TEXTBACK_GUARANTEE_MIN_LEADS=5
TEXTBACK_DEDUPE_MINUTES=10
# Set to false in local dev to accept any 6-digit phone-verify code. Keep true in production.
TEXTBACK_REQUIRE_REAL_OTP=true

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Sentry (error monitoring). Empty DSN => SDK disabled. Safe default.
# ------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENVIRONMENT="${APP_ENV}"

# ------------------------------------------------------------------
# Cloudflare Tunnel (optional, local dev). Exposes the app at a stable
# public hostname (e.g. https://dev-ash-tunnel.text-back.net) so Twilio /
# Stripe webhooks and Google OAuth can reach it. Off by default.
# When enabled, also set APP_URL + GOOGLE_REDIRECT_URI to the tunnel URL.
# See scripts/tunnel.sh and README. Not required for local sim work.
# ------------------------------------------------------------------
CLOUDFLARED_TUNNEL_NAME=
# Per-app cloudflared config (the default ~/.cloudflared/config.yml is another app's).
CLOUDFLARED_CONFIG=
